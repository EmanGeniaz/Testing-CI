# E-AI Media Intelligence — Backend Environment Variables
# Copy this file to .env and fill in your keys.
# cp .env.example .env

# ── LLM Provider API Keys ─────────────────────────────────────────────────────
# Fill in the key for whichever provider(s) you want to use.
# The frontend also lets you pick provider/model at runtime.

OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ── Optional: pin a specific model per provider ───────────────────────────────
# OPENAI_MODEL=gpt-4o-mini
# GROQ_MODEL=llama-3.3-70b-versatile
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022
# GOOGLE_MODEL=gemini-1.5-flash

# ── Optional: tuning ──────────────────────────────────────────────────────────
# BATCH_SIZE=5
# MAX_WORKERS=3

# ── TEST_ROW_LIMIT ─────────────────────────────────────────────────────────────
# Caps the number of rows tagged per run. Useful for SME testing on deployed
# environments to keep LLM costs bounded. Set to 0 (default) to disable.
# TEST_ROW_LIMIT=20

# ── DATA_DIR ──────────────────────────────────────────────────────────────────
# Where database.json, runs.json, runs/ and app.log are written. On Render this
# should point at a persistent disk mount (see render.yaml at the repo root).
# Defaults to the backend directory for local dev.
# DATA_DIR=/var/data
