# E-AI Media Intelligence — Backend Environment Variables
# Copy this file to .env and fill in your keys.
# cp .env.example .env

# ── LLM Provider API Keys ─────────────────────────────────────────────────────
# Fill in the key for whichever provider(s) you want to use.
# The frontend also lets you pick provider/model at runtime.

OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ── Optional: pin a specific model per provider ───────────────────────────────
# OPENAI_MODEL=gpt-4o-mini
# GROQ_MODEL=llama-3.3-70b-versatile
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022
# GOOGLE_MODEL=gemini-1.5-flash

# ── Optional: tuning ──────────────────────────────────────────────────────────
# BATCH_SIZE=5
# MAX_WORKERS=3
